// Copy of what scripts/gen-secrets.sh writes to Config/Secrets.xcconfig (gitignored).
// Only public, browser-exposed values belong here — never server secrets.
SUPABASE_URL = https:/$()/<project>.supabase.co
SUPABASE_ANON_KEY = <anon key>
LOGO_DEV_TOKEN = pk_<token>
TURNSTILE_SITE_KEY = 0x<site key>
