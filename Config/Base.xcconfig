// Shared build configuration. Only public values live here or in Secrets.xcconfig.
// `//` starts a comment in xcconfig, so URLs escape it as `/$()/`.

API_BASE_URL = https:/$()/www.amsa.mn

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2

// Apple Developer Program team used for device and TestFlight builds.
AMSA_DEVELOPMENT_TEAM = 4W55D23N4Z

// Push notifications. Needs a paid Apple Developer Program team (the one above); empty it to
// build with a free Personal Team, which can't sign push.
AMSA_CODE_SIGN_ENTITLEMENTS = AMSA/AMSA.entitlements

// Generated by scripts/gen-secrets.sh from .env (whitelisted public keys only).
#include? "Secrets.xcconfig"
