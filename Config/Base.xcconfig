// Shared build configuration. Only public values live here or in Secrets.xcconfig.
// `//` starts a comment in xcconfig, so URLs escape it as `/$()/`.

API_BASE_URL = https:/$()/www.amsa.mn

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Set your Apple Developer team here (or in Secrets.xcconfig) for device/TestFlight builds.
AMSA_DEVELOPMENT_TEAM = CC45F3G586

// Push notifications. Free Personal Teams can't sign them, so this stays empty until the team
// above is a paid Apple Developer Program team; then set it to AMSA/AMSA.entitlements.
AMSA_CODE_SIGN_ENTITLEMENTS =

// Generated by scripts/gen-secrets.sh from .env (whitelisted public keys only).
#include? "Secrets.xcconfig"
