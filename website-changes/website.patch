+ * both pages and requires agreeing to the Terms at signup.
+ */
+export const SUPPORT_EMAIL = "administration@amsa.mn";
+export const LEGAL_EFFECTIVE_DATE = "October 2, 2026";
diff --git a/src/lib/push.ts b/src/lib/push.ts
new file mode 100644
index 0000000..f1874d6
--- /dev/null
+++ b/src/lib/push.ts
@@ -0,0 +1,203 @@
+import "server-only";
+import http2 from "node:http2";
+import jwt from "jsonwebtoken";
+import { supabase } from "@/lib/supabase";
+
+/**
+ * Push notifications to the iOS app through Apple Push Notification service (APNs).
+ *
+ * Off until APNS_KEY (the .p8 file's contents), APNS_KEY_ID and APNS_TEAM_ID are set.
+ * Every send is best-effort: it never throws, so callers run it in `after()` and move on.
+ * The texts and links mirror get_notifications, so a push and the row it becomes on the
+ * notifications page say the same thing.
+ */
+
+const KEY = process.env.APNS_KEY?.replace(/\\n/g, "\n");
+const KEY_ID = process.env.APNS_KEY_ID;
+const TEAM_ID = process.env.APNS_TEAM_ID;
+const BUNDLE_ID = process.env.APNS_BUNDLE_ID || "mn.amsa.app";
+
+const HOSTS = {
+  production: "https://api.push.apple.com",
+  sandbox: "https://api.sandbox.push.apple.com",
+} as const;
+type Environment = keyof typeof HOSTS;
+
+/** Roles whose profiles are public in the network (and who can answer questions). */
+const PROFILE_ROLES = ["ambassador", "us_member", "board_member", "admin"];
+
+type Push = { title: string; body: string; href?: string | null };
+type NameRow = { firstName: string | null; lastName: string | null };
+
+// APNs accepts a provider token for up to an hour and rejects refreshes more often than every
+// 20 minutes, so one is reused for 50.
+let providerToken: { value: string; issuedAt: number } | null = null;
+
+function bearer(): string {
+  if (!providerToken || Date.now() - providerToken.issuedAt > 50 * 60_000) {
+    const value = jwt.sign({}, KEY!, { algorithm: "ES256", keyid: KEY_ID, issuer: TEAM_ID });
+    providerToken = { value, issuedAt: Date.now() };
+  }
+  return providerToken.value;
+}
+
+function displayName(user: NameRow | null | undefined): string {
+  return `${user?.firstName ?? ""} ${user?.lastName ?? ""}`.trim() || "Someone";
+}
+
+/** Sends `payload` to each token over one HTTP/2 connection. Resolves to the tokens APNs rejected for good. */
+function deliver(environment: Environment, tokens: string[], payload: string): Promise<string[]> {
+  return new Promise((resolve) => {
+    const stale: string[] = [];
+    let pending = tokens.length;
+    const client = http2.connect(HOSTS[environment]);
+    const finish = () => {
+      if (--pending === 0) {
+        client.close();
+        resolve(stale);
+      }
+    };
+    client.on("error", (error) => {
+      console.error("APNs connection failed:", error);
+      client.destroy();
+      resolve(stale);
+    });
+
+    for (const token of tokens) {
+      const request = client.request({
+        ":method": "POST",
+        ":path": `/3/device/${token}`,
+        authorization: `bearer ${bearer()}`,
+        "apns-topic": BUNDLE_ID,
+        "apns-push-type": "alert",
+        "content-type": "application/json",
+      });
+      let status = 0;
+      let body = "";
+      request.setEncoding("utf8");
+      request.on("response", (headers) => {
+        status = Number(headers[":status"]);
+      });
+      request.on("data", (chunk) => {
+        body += chunk;
+      });
+      request.on("end", () => {
+        if (status !== 200) {
+          const reason = (() => {
+            try {
+              return JSON.parse(body).reason as string | undefined;
+            } catch {
+              return undefined;
+            }
+          })();
+          // 410: the app was uninstalled or the token expired.
+          if (status === 410 || reason === "BadDeviceToken" || reason === "DeviceTokenNotForTopic") stale.push(token);
+          else console.error(`APNs rejected a push (${status}):`, reason ?? body);
+        }
+        finish();
+      });
+      request.on("error", (error) => {
+        console.error("APNs request failed:", error);
+        finish();
+      });
+      request.end(payload);
+    }
+  });
+}
+
+/** Pushes to every device the given members are signed in on. */
+export async function sendPush(userIds: number[], push: Push): Promise<void> {
+  if (!KEY || !KEY_ID || !TEAM_ID || userIds.length === 0) return;
+  try {
+    const { data, error } = await supabase
+      .from("DeviceTokens")
+      .select("token, environment")
+      .in("userId", userIds);
+    if (error) throw error;
+    const rows = (data ?? []) as { token: string; environment: Environment }[];
+    if (rows.length === 0) return;
+
+    const payload = JSON.stringify({
+      aps: { alert: { title: push.title, body: push.body }, sound: "default" },
+      ...(push.href ? { href: push.href } : {}),
+    });
+    const stale = (
+      await Promise.all(
+        (Object.keys(HOSTS) as Environment[]).map((environment) => {
+          const tokens = rows.filter((r) => r.environment === environment).map((r) => r.token);
+          return tokens.length ? deliver(environment, tokens, payload) : Promise.resolve([]);
+        }),
+      )
+    ).flat();
+    if (stale.length) await supabase.from("DeviceTokens").delete().in("token", stale);
+  } catch (error) {
+    console.error("Push failed:", error);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// One function per event. Each looks up the names it needs, so routes only pass ids.
+// ---------------------------------------------------------------------------
+
+export async function pushNewFollower(followerId: number, followingId: number): Promise<void> {
+  const { data: follower } = await supabase
+    .from("Users")
+    .select("firstName, lastName, role")
+    .eq("id", followerId)
+    .maybeSingle<NameRow & { role: string | null }>();
+  await sendPush([followingId], {
+    title: "New follower",
+    body: `${displayName(follower)} followed you.`,
+    href: PROFILE_ROLES.includes(follower?.role ?? "") ? `/dashboard/network/${followerId}` : null,
+  });
+}
+
+export async function pushNewQuestion(asker: NameRow | null, recipientId: number): Promise<void> {
+  await sendPush([recipientId], {
+    title: "New question",
+    body: `${displayName(asker)} asked you a question.`,
+    href: "/welcome?threads=unanswered",
+  });
+}
+
+export async function pushQuestionAnswered(
+  askerId: number,
+  answerer: NameRow | null,
+  isAnonymous: boolean,
+): Promise<void> {
+  await sendPush([askerId], {
+    title: "Question answered",
+    body: `${isAnonymous ? "Someone" : displayName(answerer)} answered your question.`,
+    href: "/dashboard/inbox",
+  });
+}
+
+export async function pushMembershipDecision(userId: number, approved: boolean): Promise<void> {
+  await sendPush(
+    [userId],
+    approved
+      ? {
+          title: "Membership approved",
+          body: "Your AMSA membership application was approved. Welcome aboard!",
+          href: "/verification",
+        }
+      : {
+          title: "Membership application update",
+          body: "Your AMSA membership application wasn't approved. Open it to see the details.",
+          href: "/verification",
+        },
+  );
+}
+
+/** To every admin: they're the ones who review applications. */
+export async function pushNewApplication(applicantName: string): Promise<void> {
+  const { data: admins } = await supabase.from("Users").select("id").eq("role", "admin");
+  await sendPush(
+    ((admins ?? []) as { id: number }[]).map((a) => a.id),
+    {
+      title: "New membership application",
+      body: `${applicantName.trim() || "Someone"} applied for membership.`,
+      href: "/dashboard/admin/verification",
+    },
+  );
+}
diff --git a/src/lib/reports.ts b/src/lib/reports.ts
new file mode 100644
index 0000000..d8ac74d
--- /dev/null
+++ b/src/lib/reports.ts
@@ -0,0 +1,216 @@
+import "server-only";
+import { supabase } from "@/lib/supabase";
+import { toUserId } from "@/lib/blocks";
+
+export const REPORT_TARGET_TYPES = [
+  "post",
+  "hub_thread",
+  "hub_comment",
+  "college_review",
+  "place_review",
+  "question",
+  "user",
+] as const;
+export type ReportTargetType = (typeof REPORT_TARGET_TYPES)[number];
+
+export const REPORT_REASONS = [
+  "spam",
+  "harassment",
+  "hate",
+  "sexual",
+  "violence",
+  "self_harm",
+  "misinformation",
+  "other",
+] as const;
+export type ReportReason = (typeof REPORT_REASONS)[number];
+
+export const REPORT_REASON_LABELS: Record<ReportReason, string> = {
+  spam: "Spam or scam",
+  harassment: "Harassment or bullying",
+  hate: "Hate speech",
+  sexual: "Sexual content",
+  violence: "Violence or threats",
+  self_harm: "Self-harm",
+  misinformation: "False information",
+  other: "Something else",
+};
+
+export const REPORT_TARGET_LABELS: Record<ReportTargetType, string> = {
+  post: "Post",
+  hub_thread: "Thread",
+  hub_comment: "Comment",
+  college_review: "College review",
+  place_review: "Place review",
+  question: "Direct question",
+  user: "Member profile",
+};
+
+export type ResolvedTarget = {
+  /** Author of the content, or the member for a profile report. */
+  ownerId: number | null;
+  /** Short text moderators see in the queue and the email. */
+  preview: string;
+  /** Dashboard page where the content appears, when there is one. */
+  href: string | null;
+};
+
+const clip = (text: string | null | undefined, max = 280) => {
+  const value = (text ?? "").trim().replace(/\s+/g, " ");
+  return value.length > max ? `${value.slice(0, max)}…` : value;
+};
+
+/**
+ * Looks up the reported content. Returns null when it doesn't exist, or when
+ * `reporterId` may not report it (only the two people in a direct question can
+ * report it).
+ */
+export async function resolveTarget(
+  type: ReportTargetType,
+  targetId: string,
+  reporterId?: number,
+): Promise<ResolvedTarget | null> {
+  switch (type) {
+    case "post": {
+      const { data } = await supabase.from("Posts").select("id, userId, body").eq("id", Number(targetId)).maybeSingle();
+      if (!data) return null;
+      return { ownerId: toUserId(data.userId), preview: clip(data.body), href: `/dashboard/feed?reportedPostId=${data.id}` };
+    }
+    case "hub_thread": {
+      const { data } = await supabase
+        .from("HubThreads")
+        .select("id, askerId, title, question")
+        .eq("id", Number(targetId))
+        .maybeSingle();
+      if (!data) return null;
+      return {
+        ownerId: toUserId(data.askerId),
+        preview: clip([data.title, data.question].filter(Boolean).join(" — ")),
+        href: "/dashboard/threads",
+      };
+    }
+    case "hub_comment": {
+      const { data } = await supabase
+        .from("HubComments")
+        .select("id, authorId, content")
+        .eq("id", Number(targetId))
+        .maybeSingle();
+      if (!data) return null;
+      return { ownerId: toUserId(data.authorId), preview: clip(data.content), href: "/dashboard/threads" };
+    }
+    case "college_review": {
+      const { data } = await supabase
+        .from("college_reviews")
+        .select("id, user_id, content, college_id")
+        .eq("id", targetId)
+        .maybeSingle();
+      if (!data) return null;
+      return {
+        ownerId: toUserId(data.user_id),
+        preview: clip(data.content),
+        href: `/dashboard/research/college/${data.college_id}`,
+      };
+    }
+    case "place_review": {
+      const { data } = await supabase
+        .from("place_reviews")
+        .select("id, user_id, content, state_abbr")
+        .eq("id", targetId)
+        .maybeSingle();
+      if (!data) return null;
+      return {
+        ownerId: toUserId(data.user_id),
+        preview: clip(data.content),
+        href: `/dashboard/places/${String(data.state_abbr ?? "").toLowerCase()}`,
+      };
+    }
+    case "question": {
+      const { data } = await supabase
+        .from("Threads")
+        .select("id, askerId, recipientId, question, answer")
+        .eq("id", Number(targetId))
+        .maybeSingle();
+      if (!data) return null;
+      const askerId = toUserId(data.askerId);
+      const recipientId = toUserId(data.recipientId);
+      if (reporterId !== undefined && reporterId !== askerId && reporterId !== recipientId) return null;
+      // The reporter is flagging the other person's side of the conversation.
+      const reportingAnswer = reporterId !== undefined && reporterId === askerId;
+      return {
+        ownerId: reportingAnswer ? recipientId : askerId,
+        preview: clip(reportingAnswer ? data.answer : data.question),
+        href: null,
+      };
+    }
+    case "user": {
+      const { data } = await supabase
+        .from("Users")
+        .select("id, firstName, lastName, headline, bio")
+        .eq("id", Number(targetId))
+        .maybeSingle();
+      if (!data) return null;
+      const name = `${data.firstName ?? ""} ${data.lastName ?? ""}`.trim() || "Member";
+      return {
+        ownerId: data.id,
+        preview: clip([name, data.headline, data.bio].filter(Boolean).join(" — ")),
+        href: `/dashboard/network/${data.id}`,
+      };
+    }
+  }
+}
+
+/**
+ * Moderator "Remove": deletes the content (for a profile, clears its photo,
+ * headline and bio). Throws when the database refuses.
+ */
+export async function removeTarget(type: ReportTargetType, targetId: string): Promise<void> {
+  const check = (result: { error: { message: string } | null }) => {
+    if (result.error) throw new Error(result.error.message);
+  };
+
+  switch (type) {
+    case "post": {
+      const id = Number(targetId);
+      check(await supabase.from("PostHelpfuls").delete().eq("postId", id));
+      check(await supabase.from("PostReports").delete().eq("postId", id));
+      check(await supabase.from("Posts").delete().eq("id", id));
+      return;
+    }
+    case "hub_thread": {
+      const id = Number(targetId);
+      const { data: comments } = await supabase.from("HubComments").select("id").eq("threadId", id);
+      const commentIds = (comments ?? []).map((c: { id: number }) => c.id);
+      if (commentIds.length > 0) check(await supabase.from("HubCommentUpvotes").delete().in("commentId", commentIds));
+      check(await supabase.from("HubThreadUpvotes").delete().eq("threadId", id));
+      check(await supabase.from("HubComments").delete().eq("threadId", id));
+      check(await supabase.from("HubThreads").delete().eq("id", id));
+      return;
+    }
+    case "hub_comment": {
+      const id = Number(targetId);
+      const { data: replies } = await supabase.from("HubComments").select("id").eq("parentId", id);
+      const ids = [id, ...(replies ?? []).map((r: { id: number }) => r.id)];
+      check(await supabase.from("HubCommentUpvotes").delete().in("commentId", ids));
+      check(await supabase.from("HubComments").delete().eq("parentId", id));
+      check(await supabase.from("HubComments").delete().eq("id", id));
+      return;
+    }
+    case "college_review":
+      check(await supabase.from("college_reviews").delete().eq("id", targetId));
+      return;
+    case "place_review":
+      check(await supabase.from("place_reviews").delete().eq("id", targetId));
+      return;
+    case "question":
+      check(await supabase.from("Threads").delete().eq("id", Number(targetId)));
+      return;
+    case "user":
+      check(
+        await supabase
+          .from("Users")
+          .update({ profilePic: null, headline: null, bio: null })
+          .eq("id", Number(targetId)),
+      );
+      return;
+  }
+}
